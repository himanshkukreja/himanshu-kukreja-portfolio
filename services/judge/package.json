{
  "name": "judge-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side code judge for DSA Mastery (C++ and Java; Python and JS for verified re-judges). isolate sandbox behind an HMAC-signed HTTP gateway.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "bash test/integration.sh"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  }
}
