# /etc/judge/judge.env  (root:root, mode 0600). NEVER commit the real file.
# install-judge.sh creates it with freshly generated secrets.

# Separate keys per environment (plan 14.4). The Worker sends X-Judge-Key-Id
# matching the id before the colon. Generate each with: openssl rand -hex 32
JUDGE_HMAC_SECRETS=prod:REPLACE_WITH_64_HEX_CHARS,staging:REPLACE_WITH_64_HEX_CHARS

# Or a single key (key id "default"):
# JUDGE_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARS

# Worker pool = vCPU count by default. Uncomment to override.
# JUDGE_WORKERS=2

# Queue: 503 + Retry-After when the expected wait is over this (ms).
# JUDGE_MAX_QUEUE_WAIT_MS=30000

# Limits (defaults shown).
# JUDGE_DEFAULT_TIME_MS=2000
# JUDGE_MAX_TIME_MS=10000
# JUDGE_DEFAULT_MEMORY_MB=256
# JUDGE_MAX_MEMORY_MB=512
# JUDGE_COMPILE_MEMORY_MB=768
# JUDGE_MAX_CODE_BYTES=65536

# Signed-request clock skew window (seconds).
# JUDGE_MAX_SKEW_SEC=60

# Serve stored test sets from a directory (layout: <problemId>/<version>/{visible,hidden}.json),
# mounted read-only into the container. R2 fetch is stubbed until implemented.
# JUDGE_TESTSET_DIR=/testsets
