// Cloudflare Worker for the course site (OpenNext). Vercel ignores this file.
// Deployed by .github/workflows/cloudflare-deploy.yml: `--env staging` (sdm-course-staging on workers.dev)
// or the top level (sdm-course, the live domains once they move).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdm-course",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keepNames wraps functions in __name(): next-themes stringifies its theme script into the HTML, where
  // __name doesn't exist, so the saved theme (dark, reading modes) wasn't applied before paint
  "keep_names": false,
  // no source maps upload: they're capped at 60 MiB per upload and the whole site's server code passed that on
  // 8 Nov 2026 (61.5 MiB, staging rejected). Visitors never load them; debug from a local build instead.
  "upload_source_maps": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    // the course host answers these from public/course-brand (next.config.ts rewrites), so Next must see them
    "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
  },
  // no Smart Placement: it moved the Worker to San Jose (cf-placement: remote-SJC, 8 Nov 2026), so every request from
  // India crossed the Pacific, cached pages too (0.75-1.2 s vs 0.17 s at the visitor's colo). Learners are mostly in
  // India; the ISR bucket and tag cache are in APAC, so the visitor's colo is the right place.
  "placement": { "mode": "off" },
  // cold renders of the heaviest pages (/arena builds the question bank, ~19 s CPU) came close to the 30 s default
  "limits": { "cpu_ms": 120000 },
  "observability": { "enabled": true },
  // next/image resizing and format conversion (OpenNext uses it; without it /_next/image served full-size originals)
  "images": { "binding": "IMAGES" },
  // page copies shared by every machine and colo (cloudflare/worker.ts): the colo cache alone missed often
  "kv_namespaces": [{ "binding": "PAGES", "id": "d95b112bef4a4dc697ecc1638de83b04" }],
  // NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS: the background re-render after a release gives up at 10 s by default; an
  // LLD case study takes ~9 s cold, so its rebuilds kept failing and the old page stayed (Design Patterns release, Nov 2026)
  "vars": { "APP_ENV": "production", "SDM_SNAPSHOT": "off", "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "30000" },
  // SEARCH: the smart-search engine's own Worker (wrangler.search.jsonc; too big for this one's memory)
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course" },
    { "binding": "SEARCH", "service": "sdm-search" }
  ],
  // the deployment's id: the Worker's own page cache is kept per deployment (cloudflare/worker.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache-apac" },
    { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "triggers": { "crons": ["7 * * * *"] },
  "env": {
    "staging": {
      "name": "sdm-course-staging",
      "upload_source_maps": false,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
      },
      "placement": { "mode": "off" },
      "limits": { "cpu_ms": 120000 },
      "observability": { "enabled": true },
      "images": { "binding": "IMAGES" },
      "kv_namespaces": [{ "binding": "PAGES", "id": "19aa6193f7784663b57cb99385a3f8d9" }],
      "vars": { "APP_ENV": "preview", "SDM_SNAPSHOT": "off", "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "30000", "JUDGE_URL": "https://judge-lite.systemdesignmastery.dev", "JUDGE_KEY_ID": "staging", "DSA_BETA_EMAILS": "qa-staging@systemdesignmastery.dev" },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course-staging" },
        { "binding": "SEARCH", "service": "sdm-search-staging" }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache-staging-apac" },
        { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
      "triggers": { "crons": [] }
    }
  }
}
