// Cloudflare Worker for the course site (OpenNext). Vercel ignores this file.
// Deployed by .github/workflows/cloudflare-deploy.yml: `--env staging` (sdm-course-staging on workers.dev)
// or the top level (sdm-course, the live domains once they move).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdm-course",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keepNames wraps functions in __name(): next-themes stringifies its theme script into the HTML, where
  // __name doesn't exist, so the saved theme (dark, reading modes) wasn't applied before paint
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    // the course host answers these from public/course-brand (next.config.ts rewrites), so Next must see them
    "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
  },
  // no Smart Placement: it moved the Worker to San Jose (cf-placement: remote-SJC, 8 Nov 2026), so every request from
  // India crossed the Pacific, cached pages too (0.75-1.2 s vs 0.17 s at the visitor's colo). Learners are mostly in
  // India; the ISR bucket and tag cache are in APAC, so the visitor's colo is the right place.
  "placement": { "mode": "off" },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "production", "SDM_SNAPSHOT": "off" },
  // SEARCH: the smart-search engine's own Worker (wrangler.search.jsonc; too big for this one's memory)
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course" },
    { "binding": "SEARCH", "service": "sdm-search" }
  ],
  // the deployment's id: the Worker's own page cache is kept per deployment (cloudflare/worker.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache-apac" },
    { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "triggers": { "crons": ["7 * * * *"] },
  "env": {
    "staging": {
      "name": "sdm-course-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
      },
      "placement": { "mode": "off" },
      "observability": { "enabled": true },
      "vars": { "APP_ENV": "preview", "SDM_SNAPSHOT": "off" },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course-staging" },
        { "binding": "SEARCH", "service": "sdm-search-staging" }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache-staging-apac" },
        { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
      "triggers": { "crons": [] }
    }
  }
}
