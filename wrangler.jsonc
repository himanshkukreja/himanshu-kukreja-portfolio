// Cloudflare Worker for the course site (OpenNext). Vercel ignores this file.
// Deployed by .github/workflows/cloudflare-deploy.yml: `--env staging` (sdm-course-staging on workers.dev)
// or the top level (sdm-course, the live domains once they move).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdm-course",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    // the course host answers these from public/course-brand (next.config.ts rewrites), so Next must see them
    "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
  },
  // run near the database (Supabase, Singapore) when that is faster for the request mix
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "production", "SDM_SNAPSHOT": "off" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache" },
    { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "triggers": { "crons": ["7 * * * *"] },
  "env": {
    "staging": {
      "name": "sdm-course-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": ["/favicon.ico", "/icon.svg", "/icon.png", "/apple-icon.png", "/icons/*"]
      },
      "placement": { "mode": "smart" },
      "observability": { "enabled": true },
      "vars": { "APP_ENV": "production", "SDM_SNAPSHOT": "off" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sdm-course-staging" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sdm-course-cache-staging" },
        { "binding": "SDM_CONTENT", "bucket_name": "sdm-content" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
      "triggers": { "crons": [] }
    }
  }
}
